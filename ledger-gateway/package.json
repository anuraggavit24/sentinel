{
  "name": "sentinel-ledger-gateway",
  "version": "0.3.0",
  "private": true,
  "description": "Bridge from the Sentinel API to the fraud-intel ledger (Fabric Gateway): lookups, reports, payments with private data, chain views.",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "@hyperledger/fabric-protos": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
